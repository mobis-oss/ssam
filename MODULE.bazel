module(name = "ssam")

# Import rules_rust via bzlmod
bazel_dep(name = "rules_rust", version = "0.68.1")

# Import protobuf for prebuilt protoc toolchain
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "platforms", version = "1.0.0")

# Configure crate_universe to resolve Rust dependencies from Cargo.toml
crate = use_extension("@rules_rust//crate_universe:extension.bzl", "crate")

crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Register Rust 1.90.0 toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Prebuilt protoc repositories
# Note: While this path contains "private", it is the official way to access
# prebuilt protoc binaries and is stable across protobuf versions.
prebuilt_protoc = use_extension(
    "@protobuf//bazel/private:prebuilt_protoc_extension.bzl",
    "protoc",
)
use_repo(
    prebuilt_protoc,
    "prebuilt_protoc.linux_x86_64",
    "prebuilt_protoc.linux_aarch_64",
)
