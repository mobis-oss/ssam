load("@rules_rust//rust:defs.bzl", "rust_library")
load("//bazel/tools:cargo.bzl", "crate_cargo_env_vars")

crate_cargo_env_vars()

rust_library(
    name = "ssam-log",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ssam_log",
    edition = "2024",
    rustc_env_files = [":cargo_env_vars"],
    visibility = ["//visibility:public"],
    deps = [
        "@crates//:anyhow",
        "@crates//:log",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:simplelog",
    ],
)
