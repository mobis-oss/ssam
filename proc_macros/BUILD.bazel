load("@rules_rust//rust:defs.bzl", "rust_proc_macro")
load("//bazel/tools:cargo.bzl", "crate_cargo_env_vars")

crate_cargo_env_vars()

rust_proc_macro(
    name = "proc_macros",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env_files = [":cargo_env_vars"],
    deps = [
        "@crates//:heck",
        "@crates//:proc-macro2",
        "@crates//:quote",
        "@crates//:syn",
        "@crates//:toml",
    ],
    visibility = ["//visibility:public"],
)
