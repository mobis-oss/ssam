load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "ssam",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [
        "//libssam:libssam",
        "@crates//:anyhow",
        "@crates//:bincode",
        "@crates//:clap",
        "@crates//:expandtabs-rs",
        "@crates//:prost-types",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:term_size",
        "@crates//:tokio",
        "@crates//:tonic",
    ],
    visibility = ["//visibility:public"],
)
